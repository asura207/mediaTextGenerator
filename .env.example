# ==============================================================================
# TransM Environment Configuration Template (.env.example)
# Copy this file to '.env' or simply run 'python setup_wizard.py' / 'start.bat'
# ==============================================================================

# 1. Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 2. Database Configuration
# - DB_TYPE: 'sqlite' (파일 DB, 별도 설치 불필요 - 추천) OR 'postgres' (외부 RDB)
DB_TYPE=sqlite
SQLITE_PATH=backend/data/transm.db

# 3. PostgreSQL Database Connection (Used only when DB_TYPE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=transm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password

# 4. LLM Service Configuration (Local Ollama or Multi-Cloud API)
# - LLM_PROVIDER: 'ollama' | 'openai' | 'anthropic' | 'gemini'
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
LLM_BATCH_SIZE=10

# Cloud LLM API Keys (Optional - Can also be set in Admin Settings UI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 5. Whisper STT Configuration
# - Models: large-v3-turbo (추천), large-v3, medium, small, base
# - Device: cuda (GPU acceleration), cpu
# - Compute Type: float16, int8_float16, int8
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# 6. Local Media Search Directories (Comma or semicolon separated paths)
# Example: D:\Videos,D:\Media,E:\Movies
MEDIA_SCAN_DIRS=
